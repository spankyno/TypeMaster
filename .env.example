# Neon PostgreSQL Connection String
# Obtén tu URL de conexión en el panel web de Neon (https://console.neon.tech)
DATABASE_URL="postgresql://usuario:contraseña@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Puerto del servidor (opcional para ejecución local)
PORT=3000
NODE_ENV=development

# --- Seguridad (ver SEGURIDAD.md) ---
# Obligatoria en producción (≥ 32 caracteres aleatorios): openssl rand -base64 48
JWT_SECRET=
# Opcional: activa /api/health?deep=1 con la cabecera x-health-key (≥ 16 caracteres)
HEALTH_KEY=
# Opcional: tope de registros nuevos por hora en todo el sitio (por defecto 100)
REGISTER_GLOBAL_PER_HOUR=100
